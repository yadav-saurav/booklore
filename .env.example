# ── Database ─────────────────────────────────────────────────────────────
# Any Postgres 14+. Leave unset for local development: an embedded Postgres
# (PGlite) is created in ./data/pglite automatically.
#
#   Neon      → Dashboard → Connection string (pooled, ends with ?sslmode=require)
#   Supabase  → Project → Connect → "Transaction pooler" URI (port 6543)
#   Render    → Postgres → "Internal Database URL" (or External from outside Render)
#   Local     → postgres://user:pass@localhost:5432/booklore
DATABASE_URL=

# Max pooled connections per server instance (default 10, 3 on Vercel).
# DATABASE_POOL_MAX=

# ── Book data sources (both free, no key required) ───────────────────────
# GOOGLE_BOOKS_API_KEY=          # optional: higher free Google Books quota
# BOOKLORE_DISABLE_OPENLIBRARY=1
# BOOKLORE_DISABLE_GOOGLE=1
