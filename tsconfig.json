{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next*/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-home/types/**/*.ts",
    ".next-home/dev/types/**/*.ts",
    ".next-book/types/**/*.ts",
    ".next-book/dev/types/**/*.ts",
    ".next-recs/types/**/*.ts",
    ".next-recs/dev/types/**/*.ts",
    ".next-authors/types/**/*.ts",
    ".next-authors/dev/types/**/*.ts",
    ".next-charts/types/**/*.ts",
    ".next-charts/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/seed-data"
  ]
}
