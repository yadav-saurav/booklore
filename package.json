{
  "name": "booklore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx scripts/seed.ts",
    "db:prepare": "tsx scripts/seed.ts --if-empty",
    "vercel-build": "npm run db:prepare && next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
